# ---------- Network ----------
# Vaulto runs on BSC Testnet (chain 97), the IXS Finance test network. Optional RPC override:
RPC_URL=
NEXT_PUBLIC_RPC_URL=

# ---------- IXS (execution + vault infrastructure) ----------
IXS_API_BASE_URL=https://api-dev-v2.ixs.finance
IXS_MCP_URL=https://api-dev-v2.ixs.finance/mcp

# ---------- OpenServ (reasoning layer) ----------
# With OPENSERV_API_KEY (serv_… key) the recommendation narrative is written by the OpenServ Inference API.
# Set OPENSERV_REASONING_MODE=platform to use workspace tasks instead. Without a key Vaulto falls back to its local engine and
# labels the source in the UI.
OPENSERV_API_KEY=
# OpenServ Inference API (OpenAI-compatible, hosted by OpenServ). Default model gpt-5.4-mini; see GET /v1/models for others.
OPENSERV_INFERENCE_URL=https://inference-api.openserv.ai/v1
OPENSERV_MODEL=gpt-5.4-mini
# inference (default) or platform (workspace tasks via the Vaulto agent)
OPENSERV_REASONING_MODE=inference
# Workspace on platform.openserv.ai that contains the Vaulto agent (reasoning tasks are created there)
OPENSERV_WORKSPACE_ID=
# Optional: numeric id of the Vaulto agent in that workspace (auto-resolved by name when empty)
OPENSERV_AGENT_ID=
OPENSERV_AGENT_NAME=Vaulto
OPENSERV_AGENT_PORT=7378

# ---------- Database ----------
# PostgreSQL via Prisma. Leave empty to use the built-in JSON file store (.data/vaulto-store.json),
# which is enough for a local demo.
DATABASE_URL=

# ---------- Vaulto testnet faucet / deployer (BSC Testnet) ----------
# Fund this wallet with tBNB (gas for users) and, via the IXS team, IXS test USDC (0xbBCa…dc4f4) to hand out.
FAUCET_PRIVATE_KEY=
