# ---------- Network ----------
# Vaulto targets the IXS production vaults on BNB Chain (chain 56). Leave RPC_URL empty for the public
# BNB RPC (supports eth_call state overrides). For the video / a local run against a mainnet fork:
#   node --env-file=.env scripts/fork-demo.mjs   (KEEP=1 keeps Anvil running)  then RPC_URL=http://127.0.0.1:8545
RPC_URL=
NEXT_PUBLIC_RPC_URL=
# Avalanche C-Chain RPC (http://127.0.0.1:8546 for a fork)
AVAX_RPC_URL=
NEXT_PUBLIC_AVAX_RPC_URL=

# ---------- Policy knobs ----------
# NAV older than this many hours is treated as stale by Vaulto (the contracts also expose navStalenessThreshold()): DEFER, not REJECT
NAV_STALE_HOURS=72
# Hard cap per Live transaction, in USDC (the public demo deployment uses 150)
MAX_LIVE_TX_USDC=150
# Live mode: "opt-in" (default: Simulate until the viewer enables Live in Settings) or "off"
LIVE_MODE=opt-in

# ---------- IXS (production Vault API + MCP) ----------
IXS_API_BASE_URL=https://api-v2.ixs.finance
IXS_MCP_URL=https://api-v2.ixs.finance/mcp

# ---------- OpenServ (reasoning layer) ----------
# With OPENSERV_API_KEY (serv_… key) the allocation decision and narrative come from the OpenServ Inference API.
# Set OPENSERV_REASONING_MODE=platform to use workspace tasks instead. Without a key Vaulto falls back to its local
# engine and labels the source in the UI.
OPENSERV_API_KEY=
OPENSERV_INFERENCE_URL=https://inference-api.openserv.ai/v1
OPENSERV_MODEL=gpt-5.4-mini
# inference (default) or platform (workspace tasks via the Vaulto agent)
OPENSERV_REASONING_MODE=inference
OPENSERV_WORKSPACE_ID=
OPENSERV_AGENT_ID=
OPENSERV_AGENT_NAME=Vaulto
OPENSERV_AGENT_PORT=7378

# ---------- Database ----------
# PostgreSQL via Prisma. Leave empty to use the built-in JSON file store (.data/vaulto-store.json).
DATABASE_URL=
